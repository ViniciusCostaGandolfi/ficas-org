# Base URL of the FICAS API (Spring Boot). Used by SSR loaders/actions.
API_BASE_URL=http://localhost:8080

# Also read by the browser bundle / dev tooling.
VITE_API_BASE_URL=http://localhost:8080

# Public site origin, used to build absolute URLs for social/WhatsApp previews
# (og:image, canonical). Defaults to https://ficas.vgandolfi.dev when unset;
# set this at BUILD time after a domain swap.
# VITE_SITE_URL=https://ficas.vgandolfi.dev
