# --- Database ---
POSTGRES_DB=ficas
POSTGRES_USER=ficas
POSTGRES_PASSWORD=ficas
POSTGRES_PORT=5432

# --- API ---
API_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_JWT_SECRET=change-me-in-production-please-use-32b
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Seed admin (created on first boot)
APP_SEED_ADMIN_EMAIL=admin@ficas.org.br
APP_SEED_ADMIN_PASSWORD=admin123
APP_SEED_ADMIN_NAME=Administrador
# SMTP (contact/edital notifications) — optional in dev
APP_MAIL_ENABLED=false
APP_MAIL_HOST=smtp.gmail.com
APP_MAIL_PORT=587
APP_MAIL_USERNAME=
APP_MAIL_PASSWORD=
APP_MAIL_TO=contato@ficas.org.br

# --- Media storage (MinIO / S3) ---
# local = filesystem (default, offline); s3 = AWS S3 / MinIO via the AWS SDK.
APP_STORAGE_PROVIDER=s3
# MinIO server credentials (also used as the API's S3 access/secret key in dev).
MINIO_ROOT_USER=ficas
MINIO_ROOT_PASSWORD=ficasminio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# S3 client. Inside docker-compose the endpoint is the service DNS (http://minio:9000);
# when running the API from the host, use http://localhost:9000.
AWS_ENABLED=true
AWS_ENDPOINT=http://minio:9000
AWS_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_BUCKET_NAME=ficas-media

# --- Web ---
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
